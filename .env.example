# =========================================
# FRONTEND (Vite / Vercel / Netlify)
# =========================================
# Kosongkan jika Frontend & Backend di-host dalam 1 layanan (mis. Render / Railway).
# Isi dengan URL Backend (mis. https://uno-zero-server.onrender.com) jika Frontend di-host terpisah di Vercel/Netlify.
VITE_SERVER_URL=

# =========================================
# BACKEND SERVER (Render / Railway)
# =========================================
PORT=3001

# Daftar origin yang diizinkan (pisahkan dengan koma), atau '*' untuk akses publik semua domain
# Contoh: https://uno-zero.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# =========================================
# DATABASE PERSISTEN LEADERBOARD (Supabase)
# =========================================
# Buat proyek gratis di https://supabase.com lalu jalankan supabase/schema.sql
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Opsional (lebih aman untuk server backend):
SUPABASE_SERVICE_ROLE_KEY=
